import assert from "@std/testing/assert.mln";
import mock from "../../../toolchain/MyLangTestKit/runtime/facade.mln";
import ui from "@app/ui.mln";
import { TextField, TextLog } from "@app/ui.mln";
import elements from "@app/elements.mln";
import app_transport from "@app/runtime/transport.mln";
import app_allocator from "@app/runtime/allocator.mln";
import runtime from "@app/runtime/runtime.mln";
import terminal from "@app/terminal.mln";
import myos_service from "@std/platform/myos/service.mln";
import { UiOp } from "@contracts/myapp/ui.contract.mln";
import { Request } from "@contracts/myapp/message.contract.mln";
import { NodeId, UiError } from "@contracts/ui/widget.contract.mln";
import { OsService } from "@contracts/myos/services.contract.mln";
import { ProcBindArgs, ProcSpawnArgs } from "@contracts/myos/process-args.contract.mln";
import { SyscallFailure } from "@contracts/myos/syscall.contract.mln";
import { Pid } from "@contracts/process/control.contract.mln";
import { SpawnError } from "@contracts/process/spawn.contract.mln";
import { AllocationError } from "@std/memory/allocator.mln";
import { Result } from "@std/core/result.mln";

// What the SDK's calls put on the wire. The transport is faked, so every call
// here ends in recording_request, and no OS is needed.

i32 g_requests = 0;
Request g_last;

i32 recording_request(borrow Request request) {
    g_requests = g_requests + 1;
    g_last = request;
    return 0;
}

// Markup goes through adapters that stop the app on an error, so it needs an
// answer as well.
i32 answering_request(borrow Request request) {
    Result<NodeId, UiError> *answer = (Result<NodeId, UiError> *)request.result_out;
    *answer = Ok(NodeId(g_requests + 1));
    return recording_request(&request);
}

i32 g_service = 0;
i32 g_bound_pid = 0;
i32 g_bound_node = 0;

Result<i32, SyscallFailure> recording_service(i32 service, i32 args) {
    ProcBindArgs *bound = (ProcBindArgs *)args;
    g_service = service;
    g_bound_pid = bound->pid;
    g_bound_node = bound->output_node;
    return Ok(0);
}

i32 g_spawn_node = 0;

Result<i32, SyscallFailure> recording_spawn(i32 service, i32 args) {
    ProcSpawnArgs<Result<Pid, SpawnError>> *spawn = (ProcSpawnArgs<Result<Pid, SpawnError>> *)args;
    g_service = service;
    g_spawn_node = spawn->stdout_node;
    return Ok(0);
}

// The heap needs the OS, so what the SDK allocates comes from here.
char g_heap[8192];
i32 g_heap_used = 0;

Result<i32, AllocationError> test_alloc(i32 size) {
    i32 at = (i32)(&g_heap[g_heap_used]);
    g_heap_used = g_heap_used + size;
    return Ok(at);
}

void no_tick(i32 owner, NodeId id, i32 arg) { }

void expect_request(i32 count, i32 op, i32 a0, str what) {
    assert.assert_true(g_requests == count, what);
    assert.assert_true(g_last.op == op, what);
    assert.assert_true(g_last.a0 == a0, what);
}

/*@Test "widget calls name their operation and node" { step: 5000000; }*/
void widget_calls_name_their_operation_and_node() {
    mock.of(app_transport.request).when(mock.any()).call(recording_request);
    ui.set_checked(NodeId(5), 1);
    expect_request(1, UiOp::SET_CHECKED, 5, "set_checked");
    assert.assert_true(g_last.a1 == 1, "set_checked carries the state");
    ui.area_lines(NodeId(6));
    expect_request(2, UiOp::AREA_LINES, 6, "area_lines");
    assert.assert_true(g_last.result_out != 0, "area_lines asks for an answer");
    ui.list_count(NodeId(7));
    expect_request(3, UiOp::LIST_COUNT, 7, "list_count");
    ui.focus_window(NodeId(8));
    expect_request(4, UiOp::FOCUS_WINDOW, 8, "focus_window");
    ui.test_id(NodeId(9), "name");
    expect_request(5, UiOp::TEST_ID, 9, "test_id");
    assert.assert_true(g_last.s0_len == 4, "test_id carries the name");
}

/*@Test "a field names its operation and node" { step: 5000000; }*/
void a_field_names_its_operation_and_node() {
    mock.of(app_transport.request).when(mock.any()).call(recording_request);
    mock.of(app_allocator.alloc).when(mock.any()).call(test_alloc);
    g_requests = 0;
    TextField field = ui.field();
    runtime.attach((i32)field, NodeId(5));
    field.write("abc");
    expect_request(1, UiOp::INPUT_SET, 5, "write");
    assert.assert_true(g_last.s0_len == 3, "write carries the text");
    field.clear();
    expect_request(2, UiOp::INPUT_SET, 5, "clear");
    assert.assert_true(g_last.s0_len == 0, "clear writes nothing");
    field.append("d");
    expect_request(3, UiOp::AREA_APPEND, 5, "append");
    field.focus();
    expect_request(4, UiOp::FOCUS, 5, "focus");
    field.read();
    expect_request(5, UiOp::TEXT_COPY, 5, "read");
    assert.assert_true(g_last.result_out != 0, "read asks for an answer");
}

/*@Test "elements are one create request" { step: 5000000; }*/
void elements_are_one_create_request() {
    mock.of(app_transport.request).when(mock.any()).call(recording_request);
    g_requests = 0;
    elements.Text("hello", 3, 4, "id");
    expect_request(1, UiOp::CREATE_TEXT, 3, "Text");
    assert.assert_true(g_last.s0_len == 5 && g_last.s1_len == 2, "Text carries both strings");
    elements.Box(1, 2, 3, 4, ui.ACCENT, ui.TEXT_DISABLED);
    expect_request(2, UiOp::CREATE_BOX, 1, "Box");
    assert.assert_true(g_last.a4 == ui.ACCENT && g_last.a5 == ui.TEXT_DISABLED, "Box carries its colours");
    elements.Timer(30, no_tick);
    expect_request(3, UiOp::CREATE_TIMER, 30, "Timer");
}

NodeId text_markup() { return <Text text="hi" x={1} y={2} />; }
NodeId box_markup() { return <Box x={3} y={4} w={5} h={6} background={7} border={8} />; }
NodeId timer_markup() { return <Timer interval={9} onTick={no_tick} />; }

/*@Test "markup builds through the element adapters" { step: 5000000; }*/
void markup_builds_through_the_element_adapters() {
    mock.of(app_transport.request).when(mock.any()).call(answering_request);
    g_requests = 0;
    NodeId text = text_markup();
    expect_request(1, UiOp::CREATE_TEXT, 1, "<Text>");
    assert.assert_true((i32)text == 1, "<Text> yields the answered node");
    box_markup();
    expect_request(2, UiOp::CREATE_BOX, 3, "<Box>");
    timer_markup();
    expect_request(3, UiOp::CREATE_TIMER, 9, "<Timer>");
}

/*@Test "colours are packed RGB" { step: 100000; }*/
void colours_are_packed_rgb() {
    assert.assert_true(ui.rgb(0x1F, 0x23, 0x28) == ui.TEXT_PRIMARY, "rgb packs red, green, blue");
}

/*@Test "a terminal binds a process to one of its nodes" { step: 1000000; }*/
void a_terminal_binds_a_process_to_one_of_its_nodes() {
    mock.of(myos_service.call).when(mock.any(), mock.any()).call(recording_service);
    terminal.bind(Pid(12), NodeId(34));
    assert.assert_true(g_service == OsService::PROC_BIND, "bind names the service");
    assert.assert_true(g_bound_pid == 12 && g_bound_node == 34, "bind carries the pid and the node");
}

/*@Test "a log adds to its node and goes to a child by itself" { step: 5000000; }*/
void a_log_adds_to_its_node_and_goes_to_a_child_by_itself() {
    mock.of(app_transport.request).when(mock.any()).call(recording_request);
    mock.of(myos_service.call).when(mock.any(), mock.any()).call(recording_spawn);
    g_requests = 0;
    TextLog log = ui.log();
    runtime.attach((i32)log, NodeId(6));
    log.append("out");
    expect_request(1, UiOp::AREA_APPEND, 6, "append");
    assert.assert_true(g_last.s0_len == 3, "append carries the text");
    terminal.clear(log);
    expect_request(2, UiOp::AREA_CLEAR, 6, "clear");
    terminal.spawn_bound("hello", log);
    assert.assert_true(g_service == OsService::PROC_SPAWN, "spawn_bound names the service");
    assert.assert_true(g_spawn_node == 6, "spawn_bound carries the log's node");
}

NodeId area_markup(TextField field, TextLog log) {
    return <TextArea name="a" field={field} log={log} text="hi" />;
}

/*@Test "a text area takes its parts and its first text" { step: 5000000; }*/
void a_text_area_takes_its_parts_and_its_first_text() {
    mock.of(app_transport.request).when(mock.any()).call(answering_request);
    g_requests = 0;
    TextField field = ui.field();
    TextLog log = ui.log();
    NodeId area = area_markup(field, log);
    assert.assert_true((i32)runtime.part_node((i32)field) == (i32)area, "the field names the area");
    assert.assert_true((i32)runtime.part_node((i32)log) == (i32)area, "the log names the area");
    expect_request(2, UiOp::AREA_APPEND, (i32)area, "text");
    assert.assert_true(g_last.s0_len == 2, "text is added to the area");
}
