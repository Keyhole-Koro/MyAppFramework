import { Result } from "@std/core/result.mln";
import { Option } from "@std/core/option.mln";

// What the SDK's calls put on the wire. The transport is faked, so every call
// here ends in recording_request, and no OS is needed.

i32 g_requests = 0;
Request g_last;

i32 recording_request(borrow Request request) {
    g_requests = g_requests + 1;
    g_last = request;
    return 0;
}

// Markup goes through adapters that stop the app on an error, so it needs an
// answer as well.
i32 answering_request(borrow Request request) {
    Result<NodeId, UiError> *answer = (Result<NodeId, UiError> *)request.result_out;
    *answer = Ok(NodeId(g_requests + 1));
    return recording_request(&request);
}

i32 g_service = 0;
i32 g_bound_pid = 0;
i32 g_bound_node = 0;

Result<i32, SyscallFailure> recording_service(i32 service, i32 args) {
    ProcBindArgs *bound = (ProcBindArgs *)args;
    g_service = service;
    g_bound_pid = bound->pid;
    g_bound_node = bound->output_node;
    return Ok((i32)ProcessControlStatus::Accepted);
}

Result<i32, SyscallFailure> refusing_service(i32 service, i32 args) {
    g_service = service;
    return Ok((i32)ProcessControlStatus::Refused);
}

i32 g_spawn_node = 0;

Result<i32, SyscallFailure> recording_spawn(i32 service, i32 args) {
    ProcSpawnArgs<Result<Pid, SpawnError>> *spawn = (ProcSpawnArgs<Result<Pid, SpawnError>> *)args;
    g_service = service;
    g_spawn_node = spawn->stdout_node;
    return Ok(0);
}

// The OS never took the spawn, so it wrote no answer.
Result<i32, SyscallFailure> failing_spawn(i32 service, i32 args) {
    g_service = service;
    return Err(SyscallFailure { status: SyscallStatus::UnknownService, payload: 0 });
}

// The heap needs the OS, so what the SDK allocates comes from here.
char g_heap[8192];
i32 g_heap_used = 0;

Result<i32, AllocationError> test_alloc(i32 size) {
    i32 at = (i32)(&g_heap[g_heap_used]);
    g_heap_used = g_heap_used + size;
    return Ok(at);
}

void no_tick(i32 owner) { }

void expect_request(i32 count, i32 op, i32 a0, str what) {
    assert.assert_true(g_requests == count, what);
    assert.assert_true(g_last.op == op, what);
    assert.assert_true(g_last.a0 == a0, what);
}

/*@Test "a field names its operation and node" { step: 5000000; }*/
void a_field_names_its_operation_and_node() {
    mock.of(app_transport.request).when(mock.any()).call(recording_request);
    mock.of(app_allocator.alloc).when(mock.any()).call(test_alloc);
    g_requests = 0;
    TextField field = ui.field();
    runtime.attach((i32)field, NodeId(5));
    field.write("abc");
    expect_request(1, UiOp::INPUT_SET, 5, "write");
    assert.assert_true(g_last.s0_len == 3, "write carries the text");
    field.clear();
    expect_request(2, UiOp::INPUT_SET, 5, "clear");
    assert.assert_true(g_last.s0_len == 0, "clear writes nothing");
    field.append("d");
    expect_request(3, UiOp::AREA_APPEND, 5, "append");
    field.focus();
    expect_request(4, UiOp::FOCUS, 5, "focus");
    field.read();
    expect_request(5, UiOp::TEXT_COPY, 5, "read");
    assert.assert_true(g_last.result_out != 0, "read asks for an answer");
}

/*@Test "a list follows its values" { step: 5000000; }*/
void a_list_follows_its_values() {
    mock.of(app_transport.request).when(mock.any()).call(recording_request);
    mock.of(app_allocator.alloc).when(mock.any()).call(test_alloc);
    g_requests = 0;
    elements.bind(0, NodeId(7));
    elements.List_items(0, "a\nb");
    assert.assert_true(g_requests == 0, "the first rows are what view built");
    elements.List_items(0, "a\nb");
    assert.assert_true(g_requests == 0, "the same rows send nothing");
    elements.List_items(0, "a\nc");
    expect_request(1, UiOp::LIST_SET_ITEMS, 7, "new rows");
    elements.bind(1, NodeId(8));
    elements.List_selected(1, None);
    assert.assert_true(g_requests == 1, "the first selection is what view built");
    elements.List_selected(1, Some(3));
    expect_request(2, UiOp::LIST_SELECT, 8, "a selected row");
    assert.assert_true(g_last.a1 == 3, "the row travels");
    elements.List_selected(1, Some(3));
    assert.assert_true(g_requests == 2, "the same row sends nothing");
    elements.List_selected(1, None);
    expect_request(3, UiOp::LIST_SELECT, 8, "no selection");
    assert.assert_true(g_last.a1 == -1, "no selection is -1 on the wire");
}

/*@Test "a dialog follows when" { step: 5000000; }*/
void a_dialog_follows_when() {
    mock.of(app_transport.request).when(mock.any()).call(recording_request);
    g_requests = 0;
    elements.bind(2, NodeId(10));
    elements.Dialog_when(2, false);
    assert.assert_true(g_requests == 0, "a hidden dialog stays off the desktop");
    elements.Dialog_when(2, true);
    assert.assert_true(g_requests == 1, "it is shown when `when` turns true");
    assert.assert_true(g_last.domain == RequestDomain::APP && g_last.op == AppOp::SHOW_DIALOG, "the shell shows it");
    assert.assert_true(g_last.a0 == 10, "show names the dialog");
    elements.Dialog_when(2, true);
    assert.assert_true(g_requests == 1, "it is shown once");
    elements.Dialog_when(2, false);
    assert.assert_true(g_requests == 2 && g_last.op == AppOp::HIDE_DIALOG, "it is hidden when `when` turns false");
}

/*@Test "elements are one create request" { step: 5000000; }*/
void elements_are_one_create_request() {
    mock.of(app_transport.request).when(mock.any()).call(recording_request);
    g_requests = 0;
    elements.Text("hello", 3, 4, "id");
    expect_request(1, UiOp::CREATE_TEXT, 3, "Text");
    assert.assert_true(g_last.s0_len == 5 && g_last.s1_len == 2, "Text carries both strings");
    elements.Box(1, 2, 3, 4, ui.ACCENT, ui.TEXT_DISABLED);
    expect_request(2, UiOp::CREATE_BOX, 1, "Box");
    assert.assert_true(g_last.a4 == ui.ACCENT && g_last.a5 == ui.TEXT_DISABLED, "Box carries its colours");
    elements.Timer(30, no_tick);
    expect_request(3, UiOp::CREATE_TIMER, 30, "Timer");
}

NodeId text_markup() { return <Text text="hi" x={1} y={2} />; }
NodeId box_markup() { return <Box x={3} y={4} w={5} h={6} background={7} border={8} />; }
NodeId timer_markup() { return <Timer interval={9} onTick={no_tick} />; }

/*@Test "markup builds through the element adapters" { step: 5000000; }*/
void markup_builds_through_the_element_adapters() {
    mock.of(app_transport.request).when(mock.any()).call(answering_request);
    g_requests = 0;
    NodeId text = text_markup();
    expect_request(1, UiOp::CREATE_TEXT, 1, "<Text>");
    assert.assert_true((i32)text == 1, "<Text> yields the answered node");
    box_markup();
    expect_request(2, UiOp::CREATE_BOX, 3, "<Box>");
    timer_markup();
    expect_request(3, UiOp::CREATE_TIMER, 9, "<Timer>");
}

/*@Test "colours are packed RGB" { step: 100000; }*/
void colours_are_packed_rgb() {
    assert.assert_true(ui.rgb(0x1F, 0x23, 0x28) == ui.TEXT_PRIMARY, "rgb packs red, green, blue");
}

/*@Test "a terminal binds a process to one of its nodes" { step: 1000000; }*/
void a_terminal_binds_a_process_to_one_of_its_nodes() {
    mock.of(myos_service.call).when(mock.any(), mock.any()).call(recording_service);
    Screen screen = ui.screen();
    runtime.attach((i32)screen, NodeId(34));
    assert.assert_true(terminal.bind(Pid(12), screen).is_ok(), "an accepted bind says so");
    assert.assert_true(g_service == OsService::PROC_BIND, "bind names the service");
    assert.assert_true(g_bound_pid == 12 && g_bound_node == 34, "bind carries the pid and the node");
}

/*@Test "a refusal reaches the app" { step: 5000000; }*/
void a_refusal_reaches_the_app() {
    mock.of(myos_service.call).when(mock.any(), mock.any()).call(refusing_service);
    Screen screen = ui.screen();
    runtime.attach((i32)screen, NodeId(34));
    assert.assert_true(terminal.bind(Pid(12), screen).is_err(), "a refused bind");
    assert.assert_true(g_service == OsService::PROC_BIND, "names its service");
    assert.assert_true(terminal.unbind(Pid(12)).is_err(), "a refused unbind");
    assert.assert_true(g_service == OsService::PROC_UNBIND, "names its service");
    assert.assert_true(process.feed_line(Pid(12), "x").is_err(), "a refused line");
    assert.assert_true(g_service == OsService::PROC_FEED, "names its service");
}

/*@Test "a screen writes to its node and takes a child by itself" { step: 5000000; }*/
void a_screen_writes_to_its_node_and_takes_a_child_by_itself() {
    mock.of(app_transport.request).when(mock.any()).call(recording_request);
    mock.of(myos_service.call).when(mock.any(), mock.any()).call(recording_spawn);
    g_requests = 0;
    Screen screen = ui.screen();
    runtime.attach((i32)screen, NodeId(6));
    screen.write("out");
    expect_request(1, UiOp::AREA_APPEND, 6, "write");
    assert.assert_true(g_last.s0_len == 3, "write carries the text");
    terminal.spawn_bound("hello", screen);
    assert.assert_true(g_service == OsService::PROC_SPAWN, "spawn_bound names the service");
    assert.assert_true(g_spawn_node == 6, "spawn_bound carries the screen's node");
}

NodeId terminal_markup(Screen screen) {
    return <Terminal screen={screen} testId="t" />;
}

/*@Test "a terminal takes its screen" { step: 5000000; }*/
void a_terminal_takes_its_screen() {
    mock.of(app_transport.request).when(mock.any()).call(answering_request);
    g_requests = 0;
    Screen screen = ui.screen();
    NodeId node = terminal_markup(screen);
    assert.assert_true((i32)runtime.part_node((i32)screen) == (i32)node, "the screen names the terminal");
    expect_request(1, UiOp::CREATE_TERMINAL, 0, "<Terminal>");
}

NodeId area_markup(TextField field) {
    return <TextArea name="a" field={field} text="hi" />;
}

/*@Test "a text area takes its field and its first text" { step: 5000000; }*/
void a_text_area_takes_its_field_and_its_first_text() {
    mock.of(app_transport.request).when(mock.any()).call(answering_request);
    g_requests = 0;
    TextField field = ui.field();
    NodeId area = area_markup(field);
    assert.assert_true((i32)runtime.part_node((i32)field) == (i32)area, "the field names the area");
    expect_request(2, UiOp::AREA_APPEND, (i32)area, "text");
    assert.assert_true(g_last.s0_len == 2, "text is added to the area");
}

/*@Test "a part outside the table names no node" { step: 5000000; }*/
void a_part_outside_the_table_names_no_node() {
    runtime.attach(16, NodeId(77));
    runtime.attach(-1, NodeId(78));
    runtime.attach(1000, NodeId(79));
    assert.assert_true((i32)runtime.part_node(16) == 0, "a part past the table names no node");
    assert.assert_true((i32)runtime.part_node(-1) == 0, "a negative part names no node");
    assert.assert_true((i32)runtime.part_node(1000) == 0, "a part far past the table names no node");
    TextField field = ui.field();
    assert.assert_true((i32)field == 1, "the parts that follow are not disturbed");
    runtime.attach((i32)field, NodeId(5));
    assert.assert_true((i32)runtime.part_node((i32)field) == 5, "a part in the table still names its node");
}

/*@Test "a spawn the OS never took is an error" { step: 5000000; }*/
void a_spawn_the_os_never_took_is_an_error() {
    mock.of(myos_service.call).when(mock.any(), mock.any()).call(failing_spawn);
    Screen screen = ui.screen();
    runtime.attach((i32)screen, NodeId(6));
    Result<Pid, SpawnError> spawned = terminal.spawn_bound("hello", screen);
    assert.assert_true(g_service == OsService::PROC_SPAWN, "spawn_bound names the service");
    assert.assert_true(spawned.is_err(), "a spawn with no answer is an error");
}

// Events come from here: queue() puts one in, and the faked poll hands it
// out once.
Event g_event;
bool g_pending = false;

bool queued_poll(Event *out) {
    if (!g_pending) { return false; }
    *out = g_event;
    g_pending = false;
    return true;
}

void queue(EventKind kind, i32 id, i32 arg, i32 token) {
    g_event = Event {};
    g_event.kind = kind;
    g_event.id = id;
    g_event.arg = arg;
    g_event.token = token;
    g_pending = true;
}

// What the handlers below were called with.
i32 g_calls = 0;
i32 g_owner = 0;
i32 g_value = 0;
i32 g_second = 0;
bool g_flag = false;
i32 g_text_length = 0;
char g_text[16];

void count_call(i32 owner) {
    g_calls = g_calls + 1;
    g_owner = owner;
}

void flag_call(i32 owner, bool on) {
    count_call(owner);
    g_flag = on;
}

void row_call(i32 owner, i32 row) {
    count_call(owner);
    g_value = row;
}

void caret_call(i32 owner, i32 line, i32 column) {
    count_call(owner);
    g_value = line;
    g_second = column;
}

void text_call(i32 owner, str text) {
    count_call(owner);
    g_text_length = text.length;
    i32 i = 0;
    while (i < text.length && i < 16) {
        g_text[i] = text.data[i];
        i++;
    }
}

// A TEXT_COPY answer: the node's text is "typed".
i32 text_request(borrow Request request) {
    char *into = (char *)request.a1;
    str typed = "typed";
    i32 i = 0;
    while (i < typed.length) {
        into[i] = typed.data[i];
        i++;
    }
    Result<i32, UiError> *answer = (Result<i32, UiError> *)request.result_out;
    *answer = Ok(typed.length);
    return recording_request(&request);
}

/*@Test "no event is idle" { step: 5000000; }*/
void no_event_is_idle() {
    mock.of(app_transport.poll).when(mock.any()).call(queued_poll);
    g_pending = false;
    assert.assert_true(runtime.next() == Step::Idle, "an empty queue is idle");
}

/*@Test "a click runs its handler on the instance" { step: 5000000; }*/
void a_click_runs_its_handler_on_the_instance() {
    mock.of(app_transport.poll).when(mock.any()).call(queued_poll);
    runtime.adopt(42);
    runtime.on_event(5, EventKind::CLICK, count_call);
    queue(EventKind::CLICK, 5, 0, 0);
    assert.assert_true(runtime.next() == Step::Handled, "a click is handled");
    assert.assert_true(g_calls == 1 && g_owner == 42, "its handler runs on the adopted instance");
    queue(EventKind::CLICK, 6, 0, 0);
    assert.assert_true(runtime.next() == Step::Handled, "a click with no handler is handled");
    queue(EventKind::CHANGE, 5, 0, 0);
    runtime.next();
    assert.assert_true(g_calls == 1, "a handler runs only for its node and kind");
    assert.assert_true(runtime.next() == Step::Idle, "an event is taken once");
}

/*@Test "a handler gets what its event carries" { step: 5000000; }*/
void a_handler_gets_what_its_event_carries() {
    mock.of(app_transport.poll).when(mock.any()).call(queued_poll);
    runtime.adopt(7);
    runtime.on_flag(6, EventKind::CHANGE, flag_call);
    runtime.on_row(7, EventKind::ACTIVATE, row_call);
    runtime.on_caret(8, caret_call);
    queue(EventKind::CHANGE, 6, 1, 0);
    runtime.next();
    assert.assert_true(g_calls == 1 && g_owner == 7 && g_flag, "a flag turned on");
    queue(EventKind::CHANGE, 6, 0, 0);
    runtime.next();
    assert.assert_true(g_calls == 2 && !g_flag, "a flag turned off");
    queue(EventKind::ACTIVATE, 7, 3, 0);
    runtime.next();
    assert.assert_true(g_calls == 3 && g_value == 3, "a row");
    queue(EventKind::CARET, 8, (4 << 16) | 9, 0);
    runtime.next();
    assert.assert_true(g_calls == 4 && g_value == 4 && g_second == 9, "a caret is its line and column");
}

/*@Test "a changed text is read from its node" { step: 5000000; }*/
void a_changed_text_is_read_from_its_node() {
    mock.of(app_transport.poll).when(mock.any()).call(queued_poll);
    mock.of(app_transport.request).when(mock.any()).call(text_request);
    mock.of(app_allocator.alloc).when(mock.any()).call(test_alloc);
    g_requests = 0;
    runtime.on_text(9, EventKind::CHANGE, text_call);
    queue(EventKind::CHANGE, 9, 0, 0);
    assert.assert_true(runtime.next() == Step::Handled, "a change is handled");
    expect_request(1, UiOp::TEXT_COPY, 9, "the text is asked of its node");
    assert.assert_true(g_calls == 1, "its handler runs");
    str got = str { data: &g_text[0], length: g_text_length };
    assert.assert_str_eq(got, "typed", "the handler gets the node's text");
}

/*@Test "a key is found by its token" { step: 5000000; }*/
void a_key_is_found_by_its_token() {
    mock.of(app_transport.poll).when(mock.any()).call(queued_poll);
    runtime.on_event(77, EventKind::KEY, count_call);
    queue(EventKind::KEY, 0, 0, 77);
    runtime.next();
    assert.assert_true(g_calls == 1, "a key runs the handler of its token");
    queue(EventKind::KEY, 77, 0, 1);
    runtime.next();
    assert.assert_true(g_calls == 1, "a key's node does not name its handler");
}

/*@Test "closing the main window closes the app" { step: 5000000; }*/
void closing_the_main_window_closes_the_app() {
    mock.of(app_transport.poll).when(mock.any()).call(queued_poll);
    mock.of(app_transport.request).when(mock.any()).call(recording_request);
    g_requests = 0;
    runtime.show_main(NodeId(20));
    assert.assert_true(g_requests == 1 && g_last.op == AppOp::MAIN_WINDOW && g_last.a0 == 20, "the shell is handed the window");
    runtime.on_event(20, EventKind::CLOSE, count_call);
    runtime.on_event(21, EventKind::CLOSE, count_call);
    queue(EventKind::CLOSE, 20, 0, 0);
    assert.assert_true(runtime.next() == Step::Close, "the main window closes the app");
    assert.assert_true(g_calls == 0, "app.run closes it, not a handler");
    queue(EventKind::CLOSE, 21, 0, 0);
    assert.assert_true(runtime.next() == Step::Handled, "another window's close is handled");
    assert.assert_true(g_calls == 1, "by its handler");
}

/*@Test "an open hands over its path" { step: 5000000; }*/
void an_open_hands_over_its_path() {
    mock.of(app_transport.poll).when(mock.any()).call(queued_poll);
    queue(EventKind::OPEN, 0, 0, 0);
    str path = "/docs/a.txt";
    i32 i = 0;
    while (i < path.length) {
        g_event.text[i] = path.data[i];
        i++;
    }
    g_event.text[i] = 0;
    assert.assert_true(runtime.next() == Step::Open, "an open is the app's to do");
    str opened = runtime.opened_path();
    assert.assert_str_eq(opened, "/docs/a.txt", "the path is kept");
    queue(EventKind::OPEN, 0, 0, 0);
    g_event.text[0] = 'b';
    g_event.text[1] = 0;
    runtime.next();
    opened = runtime.opened_path();
    assert.assert_str_eq(opened, "b", "the next open replaces it");
}

// The process heap without sbrk: blocks carved from g_pool are handed to
// free(), and alloc() is served from the free list they make. A block is a
// two-word header (size, next free) and its payload.
i32 g_pool[128];

i32 pool_at(i32 offset) { return (i32)(&g_pool[0]) + offset; }

// Frees a block of `size` payload bytes whose header is at `offset`.
void give_block(i32 offset, i32 size) {
    i32 *header = (i32 *)pool_at(offset);
    *header = size;
    app_allocator.free(pool_at(offset) + 8);
}

i32 allocated(i32 size) {
    return case app_allocator.alloc(size) of {
        Ok(pointer) -> pointer;
        Err(_) -> -1;
    };
}

bool invalid_size(i32 size) {
    return case app_allocator.alloc(size) of {
        Ok(_) -> false;
        Err(error) -> error == AllocationError::InvalidSize;
    };
}

/*@Test "the heap refuses sizes it cannot give" { step: 5000000; }*/
void the_heap_refuses_sizes_it_cannot_give() {
    assert.assert_true(invalid_size(0), "zero bytes");
    assert.assert_true(invalid_size(-4), "a negative size");
    assert.assert_true(invalid_size(0x7FFFFFFF), "a size that overflows when aligned");
    app_allocator.free(0);
}

/*@Test "the heap gives out the first block that fits" { step: 5000000; }*/
void the_heap_gives_out_the_first_block_that_fits() {
    give_block(0, 16);
    give_block(128, 64);
    assert.assert_true(allocated(32) == pool_at(128) + 8, "a small block is passed over");
    assert.assert_true(allocated(13) == pool_at(0) + 8, "a size is rounded up to a block that fits");
}

/*@Test "the heap keeps its free blocks in address order" { step: 5000000; }*/
void the_heap_keeps_its_free_blocks_in_address_order() {
    give_block(200, 16);
    give_block(0, 16);
    give_block(100, 16);
    assert.assert_true(allocated(16) == pool_at(0) + 8, "the lowest block first");
    assert.assert_true(allocated(16) == pool_at(100) + 8, "then the next");
    assert.assert_true(allocated(16) == pool_at(200) + 8, "then the highest");
}

/*@Test "the heap joins a freed block to its neighbours" { step: 5000000; }*/
void the_heap_joins_a_freed_block_to_its_neighbours() {
    // Three blocks side by side: each header follows the payload before it.
    give_block(24, 16);
    give_block(48, 16);
    assert.assert_true(g_pool[6] == 40, "a block is joined to the one after it");
    give_block(0, 16);
    assert.assert_true(g_pool[0] == 64, "and to the one before it");
    assert.assert_true(allocated(64) == pool_at(0) + 8, "the joined block is given out whole");
}

// Bound text: `{"clicks: %d", c.clicks}` lowers to these calls.

/*@Test "bound text fills in its values" { step: 5000000; }*/
void bound_text_fills_in_its_values() {
    str left = elements.format("clicks: %d of %s, 100%% done");
    left = elements.format_int(left, -42);
    left = elements.format_str(left, "ten");
    str text = elements.format_end(left);
    assert.assert_str_eq(text, "clicks: -42 of ten, 100% done", "values and %% are filled in");
    left = elements.format("%s");
    left = elements.format_str(left, "only");
    text = elements.format_end(left);
    assert.assert_str_eq(text, "only", "a new format starts over");
    left = elements.format("no values");
    text = elements.format_end(left);
    assert.assert_str_eq(text, "no values", "a format with no values is its text");
}

char g_long[300];

/*@Test "bound text stops at its buffer" { step: 20000000; }*/
void bound_text_stops_at_its_buffer() {
    i32 i = 0;
    while (i < 300) {
        g_long[i] = 'x';
        i++;
    }
    str long_text = str { data: &g_long[0], length: 300 };
    str left = elements.format(long_text);
    str text = elements.format_end(left);
    assert.assert_true(text.length == 255, "a long literal is cut at the buffer");
    left = elements.format("a%sb");
    left = elements.format_str(left, long_text);
    text = elements.format_end(left);
    assert.assert_str_eq(text, "ab", "a value that does not fit is left out");
}

// OPEN's answer, written as the shell would.
bool g_open_delivered = true;

i32 open_request(borrow Request request) {
    Result<Option<NodeId>, AppError> *answer = (Result<Option<NodeId>, AppError> *)request.result_out;
    if (g_open_delivered) { *answer = Ok(Some(NodeId(3))); }
    else { *answer = Err(AppError::NotFound); }
    return recording_request(&request);
}

bool not_found(Result<_, AppError> opened) {
    AppError error = case opened of {
        Ok(_) -> ({ return false; });
        Err(value) -> value;
    };
    return case error of {
        AppError::NotFound -> true;
        _ -> false;
    };
}

/*@Test "open hands a path to the shell" { step: 5000000; }*/
void open_hands_a_path_to_the_shell() {
    mock.of(app_transport.request).when(mock.any()).call(open_request);
    g_requests = 0;
    g_open_delivered = true;
    assert.assert_true(ui.open("/docs/a.txt").is_ok(), "a delivered open is Ok");
    assert.assert_true(g_requests == 1, "one request");
    assert.assert_true(g_last.domain == RequestDomain::APP && g_last.op == AppOp::OPEN, "the shell opens it");
    assert.assert_true(g_last.s0_len == 11, "the path travels with its length");
    assert.assert_true(g_last.result_out != 0, "open asks for an answer");
    g_open_delivered = false;
    Result<_, AppError> opened = ui.open("/docs/a.zzz");
    assert.assert_true(not_found(opened), "the shell's error reaches the app");
}

/*@Test "an open the shell never answered is an error" { step: 5000000; }*/
void an_open_the_shell_never_answered_is_an_error() {
    mock.of(app_transport.request).when(mock.any()).call(recording_request);
    assert.assert_true(ui.open("/docs/a.txt").is_err(), "no answer is not a delivery");
}
