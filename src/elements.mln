package elements;

import runtime from "runtime/runtime.mln";
import { UiOp } from "../../../contracts/myapp/ui.contract.mln";
import { EventKind } from "../../../contracts/myapp/message.contract.mln";
import { Result } from "../../../toolchain/MyStdLib/result.mln";
import { UiError } from "../../../contracts/ui/widget.contract.mln";

// The markup vocabulary. `<Window title="A" x={0} w={400}>...</Window>` in a
// .dom.mln source lowers to a call of the function of the same name, with
// each property handed to the parameter of the same name and children passed
// to append_child. The vocabulary therefore lives here rather than in the
// compiler: adding an element means adding a function, and its parameters
// are its properties.
//
// A parameter with a default is an optional property, and the defaults are
// these -- position defaults to the parent's origin (what a child of a
// Column or Row wants, since the container places it), sizes to something
// sensible, handlers to none. `testId` names the node for automation.
//
// Each element is one CREATE_* request of the UI contract,
// docs/design/ui-protocol.md), answered by the UI server
// (system/MyOS/src/ui/protocol_elements.mln) with the new node's id. Handler
// parameters (on*) never leave the app: they go into the runtime's handler
// table against that id, and the server's CLICK / CHANGE / ACTIVATE / TIMER
// events come back to them as fn(owner, id, arg) -- a method or plain
// handler is passed as is, since the calling convention ignores trailing
// arguments. As processes (docs/design/os-app-boundaries.md) the request
// becomes a syscall and no markup changes.

// Children of an element are attached with the `append_child` in scope.
Result<i32, UiError> create(i32 op, i32 a0, i32 a1, i32 a2, i32 a3, i32 a4, i32 a5, char *s0, char *s1) {
    Result<i32, UiError> result = Err(UiError::UnknownOperation(op));
    runtime.send_result(op, a0, a1, a2, a3, a4, a5, s0, s1,
                        (i32)(&result), sizeof(Result<i32, UiError>));
    return result;
}

void register_handler(Result<i32, UiError> *result, i32 kind, i32 fn) {
    case *result of {
        Ok(id) -> ({ runtime.on(id, kind, fn); });
        Err(_) -> _;
    };
}

// Compiler hooks used only by `.dom.mln` lowering. Programmatic callers keep
// the Result-returning APIs above/below; markup chooses the framework's
// fail-the-instance policy for a tree that could not be constructed.
export i32 unwrap_node(Result<i32, UiError> result) {
    return case result of {
        Ok(id) -> id;
        Err(e) -> ({ runtime.fail_ui(e); 0; });
    };
}

export void unwrap_append(Result<_, UiError> result) {
    case result of {
        Ok(_) -> _;
        Err(e) -> ({ runtime.fail_ui(e); });
    };
}

export Result<_, UiError> append_child(i32 parent, i32 child) {
    return case create(UiOp::APPEND_CHILD, parent, child, 0, 0, 0, 0, "", "") of {
        Ok(ignored) -> Ok(_);
        Err(e) -> Err(e);
    };
}

/**
 * Lowers JSX `<Window title="..." x={...} y={...} w={...} h={...} testId="..." />`.
 * @param title Window title text.
 * @param x Logical X coordinate (default 0).
 * @param y Logical Y coordinate (default 0).
 * @param w Logical width (default 400).
 * @param h Logical height (default 300).
 * @param testId Stable automation locator id (default none).
 * @return DOM Node ID.
 */
export Result<i32, UiError> Window(char *title, i32 x = 0, i32 y = 0, i32 w = 400, i32 h = 300, char *testId = "") { return create(UiOp::CREATE_WINDOW, x, y, w, h, 0, 0, title, testId); }

/**
 * Lowers JSX `<Button text="..." x={...} y={...} w={...} h={...} onClick={...} testId="..." />`.
 * @param text Button label text.
 * @param x Logical X coordinate (default 0).
 * @param y Logical Y coordinate (default 0).
 * @param w Logical width (default 90).
 * @param h Logical height (default 34).
 * @param onClick Click handler function pointer (default none).
 * @param testId Stable automation locator id (default none).
 * @return DOM Node ID.
 */
export Result<i32, UiError> Button(char *text, i32 x = 0, i32 y = 0, i32 w = 90, i32 h = 34, i32 onClick = 0, char *testId = "") {
    Result<i32, UiError> result = create(UiOp::CREATE_BUTTON, x, y, w, h, 0, 0, text, testId);
    register_handler(&result, EventKind::CLICK, onClick);
    return result;
}

/**
 * Lowers JSX `<PrimaryButton text="..." x={...} y={...} w={...} h={...} onClick={...} testId="..." />`.
 * Accent-coloured call to action.
 * @param text Button label text.
 * @param x Logical X coordinate (default 0).
 * @param y Logical Y coordinate (default 0).
 * @param w Logical width (default 90).
 * @param h Logical height (default 34).
 * @param onClick Click handler function pointer (default none).
 * @param testId Stable automation locator id (default none).
 * @return DOM Node ID.
 */
export Result<i32, UiError> PrimaryButton(char *text, i32 x = 0, i32 y = 0, i32 w = 90, i32 h = 34, i32 onClick = 0, char *testId = "") {
    Result<i32, UiError> result = create(UiOp::CREATE_PRIMARY_BUTTON, x, y, w, h, 0, 0, text, testId);
    register_handler(&result, EventKind::CLICK, onClick);
    return result;
}

/**
 * Lowers JSX `<Text text="..." x={...} y={...} testId="..." />`.
 * @param text Text content string.
 * @param x Logical X coordinate (default 0).
 * @param y Logical Y coordinate (default 0).
 * @param testId Stable automation locator id (default none).
 * @return DOM Node ID.
 */
export Result<i32, UiError> Text(char *text, i32 x = 0, i32 y = 0, char *testId = "") { return create(UiOp::CREATE_TEXT, x, y, 0, 0, 0, 0, text, testId); }

/**
 * Lowers JSX `<Label text="..." x={...} y={...} color={...} bold={...} testId="..." />`.
 * Text with an explicit colour (graphics.rgb(); 0 = theme default) and weight.
 * @param text Label text string.
 * @param x Logical X coordinate (default 0).
 * @param y Logical Y coordinate (default 0).
 * @param color Text color (RGB, 0 for default).
 * @param bold Non-zero for bold styling.
 * @param testId Stable automation locator id (default none).
 * @return DOM Node ID.
 */
export Result<i32, UiError> Label(char *text, i32 x = 0, i32 y = 0, i32 color = 0, i32 bold = 0, char *testId = "") { return create(UiOp::CREATE_LABEL, x, y, color, bold, 0, 0, text, testId); }

/**
 * Lowers JSX `<Box x={...} y={...} w={...} h={...} background={...} border={...} />`.
 * @param x Logical X coordinate (default 0).
 * @param y Logical Y coordinate (default 0).
 * @param w Logical width (default 100).
 * @param h Logical height (default 100).
 * @param background Background color (RGB, default 0).
 * @param border Border color (RGB, default 0).
 * @return DOM Node ID.
 */
export Result<i32, UiError> Box(i32 x = 0, i32 y = 0, i32 w = 100, i32 h = 100,
               i32 background = 0, i32 border = 0) { return create(UiOp::CREATE_BOX, x, y, w, h, background, border, "", ""); }

/**
 * Lowers JSX `<Panel x={...} y={...} w={...} h={...} radius={...} />`.
 * @param x Logical X coordinate (default 0).
 * @param y Logical Y coordinate (default 0).
 * @param w Logical width (default 100).
 * @param h Logical height (default 100).
 * @param radius Corner radius in logical pixels (default 0).
 * @return DOM Node ID.
 */
export Result<i32, UiError> Panel(i32 x = 0, i32 y = 0, i32 w = 100, i32 h = 100, i32 radius = 0) { return create(UiOp::CREATE_PANEL, x, y, w, h, radius, 0, "", ""); }

/**
 * Lowers JSX `<Column x={...} y={...} w={...} h={...} padding={...} gap={...} />`.
 * @param x Logical X coordinate (default 0).
 * @param y Logical Y coordinate (default 0).
 * @param w Logical width (default 100).
 * @param h Logical height (default 100).
 * @param padding Inset padding in logical pixels (default 0).
 * @param gap Gap between children in logical pixels (default 0).
 * @return DOM Node ID.
 */
export Result<i32, UiError> Column(i32 x = 0, i32 y = 0, i32 w = 100, i32 h = 100,
                  i32 padding = 0, i32 gap = 0) { return create(UiOp::CREATE_COLUMN, x, y, w, h, padding, gap, "", ""); }

/**
 * Lowers JSX `<Row x={...} y={...} w={...} h={...} padding={...} gap={...} />`.
 * @param x Logical X coordinate (default 0).
 * @param y Logical Y coordinate (default 0).
 * @param w Logical width (default 100).
 * @param h Logical height (default 34).
 * @param padding Inset padding in logical pixels (default 0).
 * @param gap Gap between children in logical pixels (default 0).
 * @return DOM Node ID.
 */
export Result<i32, UiError> Row(i32 x = 0, i32 y = 0, i32 w = 100, i32 h = 34,
               i32 padding = 0, i32 gap = 0) { return create(UiOp::CREATE_ROW, x, y, w, h, padding, gap, "", ""); }

/**
 * Lowers JSX `<TextInput placeholder="..." x={...} y={...} w={...} h={...} capacity={...} onChange={...} testId="..." />`.
 * @param placeholder Placeholder text string.
 * @param x Logical X coordinate (default 0).
 * @param y Logical Y coordinate (default 0).
 * @param w Logical width (default 200).
 * @param h Logical height (default 34).
 * @param capacity Buffer capacity in bytes (default 64).
 * @param onChange Text change callback function pointer (default none).
 * @param testId Stable automation locator id (default none).
 * @return DOM Node ID.
 */
export Result<i32, UiError> TextInput(char *placeholder, i32 x = 0, i32 y = 0, i32 w = 200, i32 h = 34, i32 capacity = 64, i32 onChange = 0, char *testId = "") {
    Result<i32, UiError> result = create(UiOp::CREATE_TEXT_INPUT, x, y, w, h, capacity, 0, placeholder, testId);
    register_handler(&result, EventKind::CHANGE, onChange);
    return result;
}

/**
 * Lowers JSX `<Checkbox text="..." x={...} y={...} checked={...} onClick={...} testId="..." />`.
 * @param text Checkbox label text.
 * @param x Logical X coordinate (default 0).
 * @param y Logical Y coordinate (default 0).
 * @param checked Initial checked state (default 0).
 * @param onClick Click callback function pointer (default none).
 * @param testId Stable automation locator id (default none).
 * @return DOM Node ID.
 */
export Result<i32, UiError> Checkbox(char *text, i32 x = 0, i32 y = 0, i32 checked = 0, i32 onClick = 0, char *testId = "") {
    Result<i32, UiError> result = create(UiOp::CREATE_CHECKBOX, x, y, checked, 0, 0, 0, text, testId);
    register_handler(&result, EventKind::CLICK, onClick);
    return result;
}

/**
 * Lowers JSX `<Separator x={...} y={...} w={...} />`.
 * @param x Logical X coordinate (default 0).
 * @param y Logical Y coordinate (default 0).
 * @param w Logical width (default 100).
 * @return DOM Node ID.
 */
export Result<i32, UiError> Separator(i32 x = 0, i32 y = 0, i32 w = 100) { return create(UiOp::CREATE_SEPARATOR, x, y, w, 0, 0, 0, "", ""); }

/**
 * Lowers JSX `<Timer interval={...} onTick={...} />`.
 * @param interval Timer tick interval in system ticks.
 * @param onTick Timer callback function pointer.
 * @return DOM Node ID.
 */
export Result<i32, UiError> Timer(i32 interval, i32 onTick) {
    Result<i32, UiError> result = create(UiOp::CREATE_TIMER, interval, 0, 0, 0, 0, 0, "", "");
    register_handler(&result, EventKind::TIMER, onTick);
    return result;
}

/**
 * Lowers JSX `<TextArea name="..." x={...} y={...} w={...} h={...} capacity={...} readonly={...} onChange={...} testId="..." />`.
 * @param name Node name identifier.
 * @param x Logical X coordinate (default 0).
 * @param y Logical Y coordinate (default 0).
 * @param w Logical width (default 300).
 * @param h Logical height (default 200).
 * @param capacity Buffer capacity in bytes (default 1024).
 * @param readonly Non-zero for read-only / display console mode (default 0).
 * @param onChange Text change callback function pointer (default none).
 * @param testId Stable automation locator id (default none).
 * @return DOM Node ID.
 */
export Result<i32, UiError> TextArea(char *name, i32 x = 0, i32 y = 0, i32 w = 300, i32 h = 200, i32 capacity = 1024, i32 readonly = 0, i32 onChange = 0, char *testId = "") {
    Result<i32, UiError> result = create(UiOp::CREATE_TEXT_AREA, x, y, w, h, capacity, readonly, name, testId);
    register_handler(&result, EventKind::CHANGE, onChange);
    return result;
}

/**
 * Lowers JSX `<List name="..." x={...} y={...} w={...} h={...} capacity={...} onChange={...} onActivate={...} testId="..." />`.
 * onChange fires when the selection moves, onActivate (stored as the click
 * handler) when a row is clicked again or Enter is pressed.
 * @param name Node name identifier.
 * @param x Logical X coordinate (default 0).
 * @param y Logical Y coordinate (default 0).
 * @param w Logical width (default 300).
 * @param h Logical height (default 200).
 * @param capacity Buffer capacity in bytes (default 1024).
 * @param onChange Selection change callback function pointer (default none).
 * @param onActivate Row activation callback function pointer (default none).
 * @param testId Stable automation locator id (default none).
 * @return DOM Node ID.
 */
export Result<i32, UiError> List(char *name, i32 x = 0, i32 y = 0, i32 w = 300, i32 h = 200, i32 capacity = 1024, i32 onChange = 0, i32 onActivate = 0, char *testId = "") {
    Result<i32, UiError> result = create(UiOp::CREATE_LIST, x, y, w, h, capacity, 0, name, testId);
    register_handler(&result, EventKind::CHANGE, onChange);
    register_handler(&result, EventKind::ACTIVATE, onActivate);
    return result;
}

// `.dom.mln` adapters. JSX has an atomic tree-construction policy: it invokes
// the same typed functions above, but a failed node aborts the application
// instead of leaving a partial tree. These adapters preserve UiError all the
// way to that terminal policy; they do not translate it to a sentinel.
export void dom_append_child(i32 parent, i32 child) { unwrap_append(append_child(parent, child)); }
export i32 dom_Window(char *title, i32 x, i32 y, i32 w, i32 h, char *testId) { return unwrap_node(Window(title, x, y, w, h, testId)); }
export i32 dom_Button(char *text, i32 x, i32 y, i32 w, i32 h, i32 onClick, char *testId) { return unwrap_node(Button(text, x, y, w, h, onClick, testId)); }
export i32 dom_PrimaryButton(char *text, i32 x, i32 y, i32 w, i32 h, i32 onClick, char *testId) { return unwrap_node(PrimaryButton(text, x, y, w, h, onClick, testId)); }
export i32 dom_Text(char *text, i32 x, i32 y, char *testId) { return unwrap_node(Text(text, x, y, testId)); }
export i32 dom_Label(char *text, i32 x, i32 y, i32 color, i32 bold, char *testId) { return unwrap_node(Label(text, x, y, color, bold, testId)); }
export i32 dom_Box(i32 x, i32 y, i32 w, i32 h, i32 background, i32 border) { return unwrap_node(Box(x, y, w, h, background, border)); }
export i32 dom_Panel(i32 x, i32 y, i32 w, i32 h, i32 radius) { return unwrap_node(Panel(x, y, w, h, radius)); }
export i32 dom_Column(i32 x, i32 y, i32 w, i32 h, i32 padding, i32 gap) { return unwrap_node(Column(x, y, w, h, padding, gap)); }
export i32 dom_Row(i32 x, i32 y, i32 w, i32 h, i32 padding, i32 gap) { return unwrap_node(Row(x, y, w, h, padding, gap)); }
export i32 dom_TextInput(char *placeholder, i32 x, i32 y, i32 w, i32 h, i32 capacity, i32 onChange, char *testId) { return unwrap_node(TextInput(placeholder, x, y, w, h, capacity, onChange, testId)); }
export i32 dom_Checkbox(char *text, i32 x, i32 y, i32 checked, i32 onClick, char *testId) { return unwrap_node(Checkbox(text, x, y, checked, onClick, testId)); }
export i32 dom_Separator(i32 x, i32 y, i32 w) { return unwrap_node(Separator(x, y, w)); }
export i32 dom_Timer(i32 interval, i32 onTick) { return unwrap_node(Timer(interval, onTick)); }
export i32 dom_TextArea(char *name, i32 x, i32 y, i32 w, i32 h, i32 capacity, i32 readonly, i32 onChange, char *testId) { return unwrap_node(TextArea(name, x, y, w, h, capacity, readonly, onChange, testId)); }
export i32 dom_List(char *name, i32 x, i32 y, i32 w, i32 h, i32 capacity, i32 onChange, i32 onActivate, char *testId) { return unwrap_node(List(name, x, y, w, h, capacity, onChange, onActivate, testId)); }
