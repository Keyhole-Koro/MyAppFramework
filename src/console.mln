package console;

// Other processes, as an application (a terminal) drives them: spawn a
// program, route its stdout to one of this app's TextAreas, feed it a
// line of stdin, notice its exit and reap it. Each is an OS_CALL
// (os_services.mln) answered by MyOS's proc/console.mln.

import { os_call } from "os_call.masm";
import { OsService } from "os_services.mln";

// Start the executable at `path`; its pid, or 0.
export i32 spawn_file(char *path) {
    return spawn_bound(path, 0);
}

// Start it with its stdout already going to TextArea `node` (one of
// ours): bound before it runs, so its first output cannot slip past.
export i32 spawn_bound(char *path, i32 node) {
    i32 a[2];
    a[0] = (i32)path; a[1] = node;
    return os_call(OsService::PROC_SPAWN, (i32)(&a[0]));
}

// Send the process's stdout to TextArea `node` (one of ours).
export void bind(i32 pid, i32 node) {
    i32 a[2];
    a[0] = pid; a[1] = node;
    os_call(OsService::PROC_BIND, (i32)(&a[0]));
}

export void unbind(i32 pid) {
    i32 a[1];
    a[0] = pid;
    os_call(OsService::PROC_UNBIND, (i32)(&a[0]));
}

export bool has_exited(i32 pid) {
    i32 a[1];
    a[0] = pid;
    return os_call(OsService::PROC_EXITED, (i32)(&a[0])) != 0;
}

// Collect an exited process: its exit code.
export i32 reap(i32 pid) {
    i32 a[1];
    a[0] = pid;
    return os_call(OsService::PROC_REAP, (i32)(&a[0]));
}

// One line of stdin for the process.
export void feed_line(i32 pid, char *line) {
    i32 a[2];
    a[0] = pid; a[1] = (i32)line;
    os_call(OsService::PROC_FEED, (i32)(&a[0]));
}
