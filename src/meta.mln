package meta;

// The annotation metadata the compiler recorded, read back as rows.
//
// Every module with annotations carries a chunk of the `annotations`
// collected section: 8 words per row -- name (char*), fn, type (char*),
// size, argc, arg0, arg1, arg2 (toolchain/MyLangCompiler/docs/grammar.md,
// "Attributes and annotations"). The linker gathers every object's chunk
// into an index of (address, size) pairs between __annotations_start and
// __annotations_end (toolchain/MyLinker/inc/ObjectFormat.h, CollectEntry).
// This package flattens the chunks into one index space so a reader can
// loop 0..count() without knowing about modules or objects.

extern i32 __annotations_start[];
extern i32 __annotations_end[];

i32 ROW = 8;

i32 pairs() {
    i32 s = (i32)(&__annotations_start[0]);
    i32 e = (i32)(&__annotations_end[0]);
    return (e - s) / 8;
}

i32 chunk_addr(i32 p) { return __annotations_start[p * 2]; }
i32 chunk_rows(i32 p) { return __annotations_start[p * 2 + 1] / 32; }

// Locate row i: a pointer to its first word, or 0.
i32* row(i32 index) {
    i32 n = pairs();
    i32 p = 0;
    while (p < n) {
        i32 rows = chunk_rows(p);
        if (index < rows) {
            i32 *t = (i32*)chunk_addr(p);
            return &t[index * ROW];
        }
        index = index - rows;
        p++;
    }
    return (i32*)0;
}

export i32 count() {
    i32 total = 0;
    i32 n = pairs();
    i32 p = 0;
    while (p < n) { total = total + chunk_rows(p); p++; }
    return total;
}

export char* name(i32 i) { i32 *r = row(i); if (r == 0) { return ""; } return (char*)r[0]; }
export i32 fn(i32 i)     { i32 *r = row(i); if (r == 0) { return 0; }  return r[1]; }
export char* type(i32 i) { i32 *r = row(i); if (r == 0) { return ""; } return (char*)r[2]; }
export i32 size(i32 i)   { i32 *r = row(i); if (r == 0) { return 0; }  return r[3]; }
export i32 argc(i32 i)   { i32 *r = row(i); if (r == 0) { return 0; }  return r[4]; }

// Argument k (0..2) as recorded: a number, a bool as 0/1, or a char* as i32.
export i32 arg(i32 i, i32 k) {
    i32 *r = row(i);
    if (r == 0) { return 0; }
    if (k < 0) { return 0; }
    if (k >= 3) { return 0; }
    return r[5 + k];
}
