package fs;

// The filesystem as an application sees it: the same calls MyOS's fs.mln
// offers the kernel, each one an OS_CALL (os_services.mln) that the OS
// answers by calling its own fs.mln. Buffers and paths are the app's; the
// OS reads and writes them through the process's page tables.

import { os_call } from "os_call.masm";
import { OsService } from "os_services.mln";
import os_services from "os_services.mln";
import { Result } from "../../../toolchain/MyStdLib/result.mln";
import { Option } from "../../../toolchain/MyStdLib/option.mln";

export i32 NAME_MAX = 16;   // an entry name, NUL included (MFS)
export i32 SEEK_SET = 0;
export i32 SEEK_CUR = 1;
export i32 SEEK_END = 2;

export enum FsError {
    NotFound,
    NoFreeSlot,
    IoError,
    BadFd,
    Invalid,
    AlreadyExists,
    Other(i32),
}

FsError error_of(i32 code) {
    if (code == os_services.ERR_NOT_FOUND) { return FsError::NotFound; }
    if (code == os_services.ERR_NO_SLOT) { return FsError::NoFreeSlot; }
    if (code == os_services.ERR_IO) { return FsError::IoError; }
    if (code == os_services.ERR_BAD_FD) { return FsError::BadFd; }
    if (code == os_services.ERR_INVALID) { return FsError::Invalid; }
    if (code == os_services.ERR_EXISTS) { return FsError::AlreadyExists; }
    FsError other = Other(code);
    return other;
}

Result<i32, FsError> result_of(i32 r) {
    if (r < 0) { return Err(error_of(0 - r)); }
    return Ok(r);
}

export Result<i32, FsError> open(char *path) {
    return result_of(os_call(OsService::FS_OPEN, (i32)path));
}

export Result<i32, FsError> create(char *path) {
    return result_of(os_call(OsService::FS_CREATE, (i32)path));
}

export Result<i32, FsError> read(i32 fd, i32 buf, i32 size) {
    i32 a[3];
    a[0] = fd; a[1] = buf; a[2] = size;
    return result_of(os_call(OsService::FS_READ, (i32)(&a[0])));
}

export Result<i32, FsError> write(i32 fd, i32 buf, i32 size) {
    i32 a[3];
    a[0] = fd; a[1] = buf; a[2] = size;
    return result_of(os_call(OsService::FS_WRITE, (i32)(&a[0])));
}

export Result<i32, FsError> seek(i32 fd, i32 offset, i32 whence) {
    i32 a[3];
    a[0] = fd; a[1] = offset; a[2] = whence;
    return result_of(os_call(OsService::FS_SEEK, (i32)(&a[0])));
}

export void close(i32 fd) {
    i32 a[1];
    a[0] = fd;
    os_call(OsService::FS_CLOSE, (i32)(&a[0]));
}

export Result<_, FsError> remove(char *path) {
    i32 r = os_call(OsService::FS_REMOVE, (i32)path);
    if (r < 0) { return Err(error_of(0 - r)); }
    return Ok(_);
}

// The next entry at or after `start`: Some(index) with its name copied
// into `out`, None past the last one.
export Result<Option<i32>, FsError> dir_next(i32 start, char *out, i32 cap) {
    i32 a[3];
    a[0] = start; a[1] = (i32)out; a[2] = cap;
    i32 r = os_call(OsService::FS_DIR_NEXT, (i32)(&a[0]));
    if (r == -1) { return Ok(None); }
    if (r < 0) { return Err(error_of(0 - r)); }
    return Ok(Some(r));
}

// A new directory; its entry index.
export Result<i32, FsError> mkdir(char *path) {
    return result_of(os_call(OsService::FS_MKDIR, (i32)path));
}

// The entries of directory `dir` ("" or "/" for the root), from `start`.
export Result<Option<i32>, FsError> dir_next_at(char *dir, i32 start, char *out, i32 cap) {
    i32 a[4];
    a[0] = (i32)dir; a[1] = start; a[2] = (i32)out; a[3] = cap;
    i32 r = os_call(OsService::FS_DIR_NEXT_AT, (i32)(&a[0]));
    if (r == -1) { return Ok(None); }
    if (r < 0) { return Err(error_of(0 - r)); }
    return Ok(Some(r));
}

export bool is_dir(i32 idx) {
    i32 a[1];
    a[0] = idx;
    return os_call(OsService::FS_IS_DIR, (i32)(&a[0])) != 0;
}

export i32 entry_size(i32 idx) {
    i32 a[1];
    a[0] = idx;
    return os_call(OsService::FS_ENTRY_SIZE, (i32)(&a[0]));
}
