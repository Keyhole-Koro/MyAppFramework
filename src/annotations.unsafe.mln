package annotations;

// The annotations an application is written with -- declarations only.
//
//     import { app, timer, key } from "@app/annotations.mln";
//
//     @app(name = "Editor", single, opens)
//     struct Editor { ... };
//
//     @key("Ctrl+S")
//     void (borrow Editor e) save() { ... }
//
// Like a Java @interface, each prototype fixes a name and the shape of its
// arguments; nothing ever calls it. The compiler checks every `@name(args)`
// against the prototype and records a row -- name, the annotated function, its
// receiver type's name, the arguments -- in the module's metadata table. Whoever
// reads the rows, through MyStdLib's meta/annotations.mln, decides what they
// mean: the shell reads @app from an executable on the disk, and app.run reads
// @timer and @key from its own image.
//
// A parameter is an argument of the annotation, literal only, with a default
// for one a use may leave out. A @timer or @key method is called with the
// instance and nothing else, so it takes its receiver by reference, which the
// compiler checks.

// On a struct: the type is an application. This is what the shell knows of it
// without starting it.
// `single`: launching it again focuses the running instance instead.
// `name`: the launcher label (default: the type's name).
// `opens`: it takes the paths other apps hand to ui.open(), in App's `open`.
export void app(bool single = false, char *name = "", bool opens = false);

// The method, every `ms` milliseconds while the app runs.
export void timer(i32 ms);

// The method, when the key is pressed while the app's window is active. "Ctrl",
// "Shift", "Alt" and a key: a character, "Enter", "Esc", "Tab", "Space",
// "Left"..., "F1".."F12".
export void key(char *combo);
