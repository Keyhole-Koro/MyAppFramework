package ui;

// The UI an application is allowed to talk to. Apps import this and the
// element vocabulary (elements.mln, for markup) and nothing else, so the
// surface an app depends on is this file.
//
// This file is the interface: prototypes only, no code. The UI server
// implements every function under the same package name
// (system/MyOS/src/ui/ui_server.mln), so `ui.set_text(id, s)` links to its
// `ui_set_text`. Apps run in the server's address space for now; when they
// become processes these prototypes grow bodies that send messages, and
// nothing an app wrote changes (docs/design/os-app-boundaries.md).
//
// Every argument and result is an i32 or a char*: a node id, a handler, a
// count, a string. Nothing here takes or returns a struct, an Option or a
// Node pointer. That is deliberate -- this is the shape a message or a
// syscall can carry. "Absent" is -1 for indexes and 0 for ids and pointers.

// --- text -------------------------------------------------------------------------------------

export void set_text(i32 id, char *s);
export char* text_of(i32 id);

// Labels keep a pointer to their text rather than a copy, so formatted text
// needs a buffer that outlives the call. set_text_fmt keeps one per label
// (96 bytes, allocated on first use) and formats `fmt` into it: `%d` takes
// the next i32 argument, `%s` the next as a char*, `%%` is a percent sign.
export void set_text_fmt(i32 id, char *fmt, i32 a, i32 b);

// --- widgets --------------------------------------------------------------------------------

export bool is_checked(i32 id);
export void set_checked(i32 id, i32 on);

export void input_set(i32 id, char *s);
export void area_append(i32 id, char *s);
export void area_clear(i32 id);
export i32 area_lines(i32 id);

export void list_set_items(i32 id, char *items);
export i32 list_count(i32 id);

// Selected row, or -1.
export i32 list_selected(i32 id);

// Copy row `index`'s text into `out` (at most `cap` bytes incl. NUL);
// returns its length, or -1 for no such row.
export i32 list_item(i32 id, i32 index, char *out, i32 cap);

// --- focus and windows ------------------------------------------------------------------------

export void focus(i32 id);
export void focus_window(i32 win);

// Close a window the app opened itself (a dialog). The app's own main
// window is closed by the framework when the user closes it.
export void close(i32 win);

export i32 window_of(i32 id);
export i32 window_x(i32 win);
export i32 window_y(i32 win);

// Mount a tree the app built (a dialog) on the desktop and focus it.
export void show(i32 win);

// Name a node for automation (dom-tester locators).
export void test_id(i32 id, char *name);

// --- keys ---------------------------------------------------------------------------------------

// Simulate a key on the focused node; `type` 1 = down, 3 = char.
export void send_key(i32 type, i32 code, i32 mods);

// A raw key filter on one node: i32 handler(owner, id, code | mods << 16),
// run inline before the widget sees the key; return 1 to claim it.
export void set_key_filter(i32 id, i32 handler);

// --- colours -----------------------------------------------------------------------------------

export i32 rgb(i32 r, i32 g, i32 b);

// --- other apps ---------------------------------------------------------------------------------

// Hand a path to whichever app declares @open; returns its window or 0.
export i32 open(char *path);
