package ui;

import runtime from "runtime/runtime.mln";
import str from "@std/text/str.mln";
import { InlineString } from "@std/text/inline_string.mln";
import { InlineCString } from "@std/text/inline_c_string.mln";
import ascii from "@std/text/ascii.mln";
import { Option } from "@std/core/option.mln";
import { Result } from "@std/core/result.mln";
import { UiError } from "@contracts/ui/widget.contract.mln";
import { UiOp } from "@contracts/myapp/ui.contract.mln";
import { AppOp, AppError } from "@contracts/myapp/lifecycle.contract.mln";
import { Request } from "@contracts/myapp/message.contract.mln";

// The UI an application is allowed to talk to. Apps import this and the
// element vocabulary (elements.mln, for markup) and nothing else, so the
// surface an app depends on is this file.
//
// Each function is one request of the UI contract (contracts/myapp; the
// table is docs/design/ui-protocol.md), sent as the running instance. The
// UI protocol endpoint answers it (system/MyOS/src/ui/protocol.mln) after the
// request crosses OS_CALL and the service channel.
//
// Arguments on the wire are words and copied buffers. Semantic return values
// use Result / Option where absence and failure differ; the gateway copies
// those data-only contract values back without exposing a server pointer.

// --- text -------------------------------------------------------------------------------------

export void set_text(i32 id, char *s) {
    Request request = runtime.ui_request(UiOp::SET_TEXT);
    request.a0 = id;
    request.s0 = s;
    runtime.send(&request);
}

/** Shows a failure as `what: <message>` (`delete failed: disk full`).
 * @param id Node whose text is set, typically a status line.
 * @param what What failed.
 * @param message Why, typically an error's `describe()`.
 */
export void set_error(i32 id, char *what, char *message) {
    InlineCString<96> line = InlineCString<96> {};
    line.clear();
    line.append(str.from_c(what));
    line.append(": ");
    line.append(str.from_c(message));
    set_text(id, line.as_ptr());
}
// The node's text, copied into `out` (at most `cap` bytes incl. NUL);
// returns Ok(length), or a UI error for an invalid node/capacity. The app
// names the buffer: nothing an app holds points into the server, so a text
// longer than the buffer is cut, not read past.
export Result<i32, UiError> text_copy(i32 id, char *out, i32 cap) {
    Result<i32, UiError> result = Err(UiError::NodeNotFound(id));
    Request request = runtime.ui_request(UiOp::TEXT_COPY);
    request.a0 = id; request.a1 = (i32)out; request.a2 = cap;
    request.result_out = (i32)(&result);
    request.result_size = sizeof(Result<i32, UiError>);
    runtime.send(&request);
    return result;
}

// set_text with a format: `%d` takes the next i32 argument, `%s` the next
// as a char*, `%%` is a percent sign. (The server keeps its own copy of
// every text it is given, so the app's buffers are its own business.)
InlineCString<256> g_fmt_buf;
export void set_text_fmt(i32 id, char *fmt, i32 a, i32 b) {
    // Formatted here, in the app: a `%s` argument is a pointer into this
    // process, which only this side can read. The server gets plain text.
    g_fmt_buf.clear();
    i32 next = 0;
    i32 i = 0;
    while (fmt[i] != 0) {
        i32 c = ascii.byte(fmt[i]);
        if (c == '%') {
            i32 spec = ascii.byte(fmt[i + 1]);
            i32 value = a;
            if (next == 1) { value = b; }
            if (spec == 'd') {
                InlineString<12> decimal = value.to_string();
                g_fmt_buf.append(decimal.as_str());
                next++;
                i = i + 2;
            } else if (spec == 's') {
                if (value != 0) { g_fmt_buf.append(str.from_c((char*)value)); }
                next++;
                i = i + 2;
            } else if (spec == '%') {
                g_fmt_buf.push((u8)'%');
                i = i + 2;
            } else {
                g_fmt_buf.push((u8)c);
                i++;
            }
        } else {
            g_fmt_buf.push((u8)c);
            i++;
        }
    }
    set_text(id, g_fmt_buf.as_ptr());
}

// --- widgets --------------------------------------------------------------------------------

/** Reads a checkbox state, or returns an error for an invalid/non-checkbox node. */
export Result<bool, UiError> is_checked(i32 id) {
    Result<bool, UiError> result = Err(UiError::NodeNotFound(id));
    Request request = runtime.ui_request(UiOp::IS_CHECKED);
    request.a0 = id;
    request.result_out = (i32)(&result);
    request.result_size = sizeof(Result<bool, UiError>);
    runtime.send(&request);
    return result;
}
export void set_checked(i32 id, i32 on) {
    Request request = runtime.ui_request(UiOp::SET_CHECKED);
    request.a0 = id; request.a1 = on;
    runtime.send(&request);
}

export void input_set(i32 id, char *s) {
    Request request = runtime.ui_request(UiOp::INPUT_SET);
    request.a0 = id; request.s0 = s;
    runtime.send(&request);
}
export void area_append(i32 id, char *s) {
    Request request = runtime.ui_request(UiOp::AREA_APPEND);
    request.a0 = id; request.s0 = s;
    runtime.send(&request);
}
export void area_clear(i32 id) {
    Request request = runtime.ui_request(UiOp::AREA_CLEAR);
    request.a0 = id;
    runtime.send(&request);
}
/** Returns TextArea line count, or an error for an invalid/non-TextArea node. */
export Result<i32, UiError> area_lines(i32 id) {
    Result<i32, UiError> result = Err(UiError::NodeNotFound(id));
    Request request = runtime.ui_request(UiOp::AREA_LINES);
    request.a0 = id;
    request.result_out = (i32)(&result);
    request.result_size = sizeof(Result<i32, UiError>);
    runtime.send(&request);
    return result;
}

export void list_set_items(i32 id, char *items) {
    Request request = runtime.ui_request(UiOp::LIST_SET_ITEMS);
    request.a0 = id; request.s0 = items;
    runtime.send(&request);
}
/** Returns List item count, or an error for an invalid/non-List node. */
export Result<i32, UiError> list_count(i32 id) {
    Result<i32, UiError> result = Err(UiError::NodeNotFound(id));
    Request request = runtime.ui_request(UiOp::LIST_COUNT);
    request.a0 = id;
    request.result_out = (i32)(&result);
    request.result_size = sizeof(Result<i32, UiError>);
    runtime.send(&request);
    return result;
}

// A missing selection is Ok(None); an invalid node is Err(UiError).
export Result<Option<i32>, UiError> list_selected(i32 id) {
    Result<Option<i32>, UiError> result = Err(UiError::NodeNotFound(id));
    Request request = runtime.ui_request(UiOp::LIST_SELECTED);
    request.a0 = id;
    request.result_out = (i32)(&result);
    request.result_size = sizeof(Result<Option<i32>, UiError>);
    runtime.send(&request);
    return result;
}

// Copy row `index`'s text into `out` (at most `cap` bytes incl. NUL);
// returns its length or a typed UI error.
export Result<i32, UiError> list_item(i32 id, i32 index, char *out, i32 cap) {
    Result<i32, UiError> result = Err(UiError::InvalidIndex(index));
    Request request = runtime.ui_request(UiOp::LIST_ITEM);
    request.a0 = id; request.a1 = index; request.a2 = (i32)out; request.a3 = cap;
    request.result_out = (i32)(&result);
    request.result_size = sizeof(Result<i32, UiError>);
    runtime.send(&request);
    return result;
}

// --- focus and windows ------------------------------------------------------------------------

export void focus(i32 id) {
    Request request = runtime.ui_request(UiOp::FOCUS);
    request.a0 = id;
    runtime.send(&request);
}
export void focus_window(i32 win) {
    Request request = runtime.ui_request(UiOp::FOCUS_WINDOW);
    request.a0 = win;
    runtime.send(&request);
}

// Close a window the app opened itself (a dialog). The app's own main
// window is closed by the framework when the user closes it.
export void close(i32 win) {
    Request request = runtime.ui_request(UiOp::CLOSE);
    request.a0 = win;
    runtime.send(&request);
}

export Result<Option<i32>, UiError> window_of(i32 id) {
    Result<Option<i32>, UiError> result = Err(UiError::NodeNotFound(id));
    Request request = runtime.ui_request(UiOp::WINDOW_OF);
    request.a0 = id;
    request.result_out = (i32)(&result);
    request.result_size = sizeof(Result<Option<i32>, UiError>);
    runtime.send(&request);
    return result;
}

export Result<i32, UiError> window_x(i32 win) {
