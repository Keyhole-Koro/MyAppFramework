package ui;

import runtime from "runtime/runtime.mln";
import strbuf from "../../../toolchain/MyStdLib/text/strbuf.mln";
import { Option } from "../../../toolchain/MyStdLib/option.mln";
import { Result } from "../../../toolchain/MyStdLib/result.mln";
import { UiError } from "../../../contracts/ui/widget.contract.mln";
import { UiOp } from "../../../contracts/myapp/ui.contract.mln";
import { AppOp } from "../../../contracts/myapp/lifecycle.contract.mln";

// The UI an application is allowed to talk to. Apps import this and the
// element vocabulary (elements.mln, for markup) and nothing else, so the
// surface an app depends on is this file.
//
// Each function is one request of the UI contract (contracts/myapp; the
// table is docs/design/ui-protocol.md), sent as the running instance. The
// UI protocol endpoint answers it (system/MyOS/src/ui/protocol.mln) after the
// request crosses OS_CALL and the service channel.
//
// Arguments on the wire are words and copied buffers. Semantic return values
// use Result / Option where absence and failure differ; the gateway copies
// those data-only contract values back without exposing a server pointer.

// --- text -------------------------------------------------------------------------------------

export void set_text(i32 id, char *s) { runtime.send(UiOp::SET_TEXT, id, 0, 0, 0, 0, 0, s, ""); }
// The node's text, copied into `out` (at most `cap` bytes incl. NUL);
// returns its length. The app names the buffer: nothing an app holds
// points into the server, so a text longer than the buffer is cut, not
// read past.
export i32 text_copy(i32 id, char *out, i32 cap) { return runtime.send(UiOp::TEXT_COPY, id, (i32)out, cap, 0, 0, 0, "", ""); }

// set_text with a format: `%d` takes the next i32 argument, `%s` the next
// as a char*, `%%` is a percent sign. (The server keeps its own copy of
// every text it is given, so the app's buffers are its own business.)
char g_fmt_buf[256];
export void set_text_fmt(i32 id, char *fmt, i32 a, i32 b) {
    // Formatted here, in the app: a `%s` argument is a pointer into this
    // process, which only this side can read. The server gets plain text.
    char *buf = &g_fmt_buf[0];
    i32 n = strbuf.reset(buf);
    i32 next = 0;
    i32 i = 0;
    while (fmt[i] != 0) {
        i32 c = fmt[i] & 0xFF;
        if (c == '%') {
            i32 spec = fmt[i + 1] & 0xFF;
            i32 value = a;
            if (next == 1) { value = b; }
            if (spec == 'd') {
                n = strbuf.append_i32(buf, 256, n, value);
                next++;
                i = i + 2;
            } else if (spec == 's') {
                if (value != 0) { n = strbuf.append(buf, 256, n, (char*)value); }
                next++;
                i = i + 2;
            } else if (spec == '%') {
                n = strbuf.push(buf, 256, n, '%');
                i = i + 2;
            } else {
                n = strbuf.push(buf, 256, n, c);
                i++;
            }
        } else {
            n = strbuf.push(buf, 256, n, c);
            i++;
        }
    }
    set_text(id, buf);
}

// --- widgets --------------------------------------------------------------------------------

export bool is_checked(i32 id) { return runtime.send(UiOp::IS_CHECKED, id, 0, 0, 0, 0, 0, "", "") != 0; }
export void set_checked(i32 id, i32 on) { runtime.send(UiOp::SET_CHECKED, id, on, 0, 0, 0, 0, "", ""); }

export void input_set(i32 id, char *s) { runtime.send(UiOp::INPUT_SET, id, 0, 0, 0, 0, 0, s, ""); }
export void area_append(i32 id, char *s) { runtime.send(UiOp::AREA_APPEND, id, 0, 0, 0, 0, 0, s, ""); }
export void area_clear(i32 id) { runtime.send(UiOp::AREA_CLEAR, id, 0, 0, 0, 0, 0, "", ""); }
export i32 area_lines(i32 id) { return runtime.send(UiOp::AREA_LINES, id, 0, 0, 0, 0, 0, "", ""); }

export void list_set_items(i32 id, char *items) { runtime.send(UiOp::LIST_SET_ITEMS, id, 0, 0, 0, 0, 0, items, ""); }
export i32 list_count(i32 id) { return runtime.send(UiOp::LIST_COUNT, id, 0, 0, 0, 0, 0, "", ""); }

// A missing selection is Ok(None); an invalid node is Err(UiError).
export Result<Option<i32>, UiError> list_selected(i32 id) {
    Result<Option<i32>, UiError> result = Err(UiError::NodeNotFound(id));
    runtime.send_result(
        UiOp::LIST_SELECTED,
        id, 0, 0, 0, 0, 0, "", "",
        (i32)(&result), sizeof(Result<Option<i32>, UiError>)
    );
    return result;
}

// Copy row `index`'s text into `out` (at most `cap` bytes incl. NUL);
// returns its length or a typed UI error.
export Result<i32, UiError> list_item(i32 id, i32 index, char *out, i32 cap) {
    Result<i32, UiError> result = Err(UiError::InvalidIndex(index));
    runtime.send_result(
        UiOp::LIST_ITEM,
        id, index, (i32)out, cap, 0, 0, "", "",
        (i32)(&result), sizeof(Result<i32, UiError>)
    );
    return result;
}

// --- focus and windows ------------------------------------------------------------------------

export void focus(i32 id) { runtime.send(UiOp::FOCUS, id, 0, 0, 0, 0, 0, "", ""); }
export void focus_window(i32 win) { runtime.send(UiOp::FOCUS_WINDOW, win, 0, 0, 0, 0, 0, "", ""); }

// Close a window the app opened itself (a dialog). The app's own main
// window is closed by the framework when the user closes it.
export void close(i32 win) { runtime.send(UiOp::CLOSE, win, 0, 0, 0, 0, 0, "", ""); }

export Result<Option<i32>, UiError> window_of(i32 id) {
    Result<Option<i32>, UiError> result = Err(UiError::NodeNotFound(id));
    runtime.send_result(UiOp::WINDOW_OF, id, 0, 0, 0, 0, 0, "", "",
                        (i32)(&result), sizeof(Result<Option<i32>, UiError>));
    return result;
}

export Result<i32, UiError> window_x(i32 win) {
    Result<i32, UiError> result = Err(UiError::NodeNotFound(win));
    runtime.send_result(UiOp::WINDOW_X, win, 0, 0, 0, 0, 0, "", "",
                        (i32)(&result), sizeof(Result<i32, UiError>));
    return result;
}

export Result<i32, UiError> window_y(i32 win) {
    Result<i32, UiError> result = Err(UiError::NodeNotFound(win));
    runtime.send_result(UiOp::WINDOW_Y, win, 0, 0, 0, 0, 0, "", "",
                        (i32)(&result), sizeof(Result<i32, UiError>));
    return result;
}

// Mount a tree the app built (a dialog) on the desktop and focus it.
export void show(i32 win) { runtime.send(UiOp::SHOW, win, 0, 0, 0, 0, 0, "", ""); }

// Name a node for automation (dom-tester locators).
export void test_id(i32 id, char *name) { runtime.send(UiOp::TEST_ID, id, 0, 0, 0, 0, 0, name, ""); }

// --- keys ---------------------------------------------------------------------------------------

// Simulate a key on the focused node; `type` 1 = down, 3 = char.
export void send_key(i32 type, i32 code, i32 mods) { runtime.send(UiOp::SEND_KEY, type, code, mods, 0, 0, 0, "", ""); }

// --- colours -----------------------------------------------------------------------------------

export i32 rgb(i32 r, i32 g, i32 b) { return runtime.send(UiOp::RGB, r, g, b, 0, 0, 0, "", ""); }

// --- other apps ---------------------------------------------------------------------------------

// Hand a path to whichever app declares @open; returns its window or 0.
export i32 open(char *path) { return runtime.app_send(AppOp::OPEN, 0, path); }
