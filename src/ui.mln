package ui;

import runtime from "runtime/runtime.mln";
import str from "@std/text/str.mln";
import ascii from "@std/text/ascii.mln";
import { Option } from "@std/core/option.mln";
import { Result } from "@std/core/result.mln";
import { NodeId, UiError } from "@contracts/ui/widget.contract.mln";
import { UiOp } from "@contracts/myapp/ui.contract.mln";
import { AppOp, AppError } from "@contracts/myapp/lifecycle.contract.mln";
import { Request } from "@contracts/myapp/message.contract.mln";

// The UI an application is allowed to talk to. Apps import this and the
// element vocabulary (elements.mln, for markup) and nothing else, so the
// surface an app depends on is this file.
//
// Each function is one request of the UI contract (contracts/myapp; the
// table is docs/design/ui-protocol.md), sent as the running instance. The
// UI protocol endpoint answers it (system/MyOS/src/ui/protocol.mln) after the
// request crosses OS_CALL and the service channel.
//
// Arguments on the wire are words and copied buffers. Semantic return values
// use Result / Option where absence and failure differ; the gateway copies
// those data-only contract values back without exposing a server pointer.

// --- widgets --------------------------------------------------------------------------------

export void set_checked(NodeId id, i32 on) {
    Request request = runtime.ui_request(UiOp::SET_CHECKED);
    request.a0 = (i32)id; request.a1 = on;
    runtime.send(&request);
}

export void input_set(NodeId id, str s) {
    Request request = runtime.ui_request(UiOp::INPUT_SET);
    request.a0 = (i32)id; runtime.put_s0(&request, s);
    runtime.send(&request);
}
export void area_append(NodeId id, str s) {
    Request request = runtime.ui_request(UiOp::AREA_APPEND);
    request.a0 = (i32)id; runtime.put_s0(&request, s);
    runtime.send(&request);
}
export void area_clear(NodeId id) {
    Request request = runtime.ui_request(UiOp::AREA_CLEAR);
    request.a0 = (i32)id;
    runtime.send(&request);
}
/** Returns TextArea line count, or an error for an invalid/non-TextArea node. */
export Result<i32, UiError> area_lines(NodeId id) {
    Result<i32, UiError> result = Err(UiError::NodeNotFound(id));
    Request request = runtime.ui_request(UiOp::AREA_LINES);
    request.a0 = (i32)id;
    runtime.ask_i32(&request, &result);
    return result;
}

/** Returns List item count, or an error for an invalid/non-List node. */
export Result<i32, UiError> list_count(NodeId id) {
    Result<i32, UiError> result = Err(UiError::NodeNotFound(id));
    Request request = runtime.ui_request(UiOp::LIST_COUNT);
    request.a0 = (i32)id;
    runtime.ask_i32(&request, &result);
    return result;
}


// --- parts ------------------------------------------------------------------------------------

/** Text the DOM keeps: what is being typed, or an Editor's body. An app gets
 * one in `start` and gives it to an element with `field=`. */
export newtype TextField = i32;

/** A new field. */
export TextField field() { return TextField(runtime.new_part()); }

/** The text, valid until the next read. */
export str (TextField f) read() { return runtime.read_text(runtime.part_node((i32)f)); }

/** Replaces the text. */
export void (TextField f) write(str text) { input_set(runtime.part_node((i32)f), text); }

/** Adds to the end of a TextArea's text. */
export void (TextField f) append(str text) { area_append(runtime.part_node((i32)f), text); }

/** Empties the field. */
export void (TextField f) clear() { input_set(runtime.part_node((i32)f), ""); }

/** Moves the keyboard to the field. */
export void (TextField f) focus() { focus(runtime.part_node((i32)f)); }

/** Text the DOM keeps that only grows: a Terminal's output. An app gets one in
 * `start` and gives it to a TextArea with `log=`. */
export newtype TextLog = i32;

/** A new log. */
export TextLog log() { return TextLog(runtime.new_part()); }

/** Adds to the end of the log. */
export void (TextLog l) append(str text) { area_append(runtime.part_node((i32)l), text); }

// --- focus and windows ------------------------------------------------------------------------

export void focus(NodeId id) {
    Request request = runtime.ui_request(UiOp::FOCUS);
    request.a0 = (i32)id;
    runtime.send(&request);
}
export void focus_window(NodeId win) {
    Request request = runtime.ui_request(UiOp::FOCUS_WINDOW);
    request.a0 = (i32)win;
    runtime.send(&request);
}

// Name a node for automation (dom-tester locators).
export void test_id(NodeId id, str name) {
    Request request = runtime.ui_request(UiOp::TEST_ID);
    request.a0 = (i32)id; runtime.put_s0(&request, name);
    runtime.send(&request);
}

// --- keys ---------------------------------------------------------------------------------------

// Simulate a key on the focused node; `type` 1 = down, 3 = char.
export void send_key(i32 type, i32 code, i32 mods) {
    Request request = runtime.ui_request(UiOp::SEND_KEY);
    request.a0 = type; request.a1 = code; request.a2 = mods;
    runtime.send(&request);
}

// --- colours -----------------------------------------------------------------------------------

export i32 rgb(i32 r, i32 g, i32 b) {
    return (r << 16) | (g << 8) | b;
}

// Theme colours for the colour attributes: `color={ui.TEXT_SECONDARY}`.
// Apps do not see the OS theme (@os/ui/theme.mln), so these repeat its
// values; keep them in step when the theme changes.
export const i32 TEXT_PRIMARY = 0x1F2328;   // body text (the default)
export const i32 TEXT_SECONDARY = 0x6B7280; // hints, captions, status lines
export const i32 TEXT_DISABLED = 0xA0A6B0;  // unavailable items
export const i32 ACCENT = 0x3B82F6;         // highlights and primary actions

// --- other apps ---------------------------------------------------------------------------------

/** Hand a path to whichever app declares @open.
 * @param path NUL-terminated path to open.
 * @return Ok(Some(window)) when delivered immediately, Ok(None) while the
 *         target app is starting, or Err when opening cannot be completed.
 */
export Result<Option<NodeId>, AppError> open(str path) {
    Result<Option<NodeId>, AppError> result = Err(AppError::NoOpenHandler);
    Request request = runtime.app_request(AppOp::OPEN);
    runtime.put_s0(&request, path);
    runtime.ask_app_option(&request, &result);
    return result;
}
