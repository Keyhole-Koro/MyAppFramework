package annotations;

// The annotations an application is written with -- declarations only.
//
//     import { app, timer, key } from ".../annotations.mln";
//
//     @app(single, name = "Editor")
//     i32 (Editor *e) view() { return <Window ...>...</Window>; }
//
//     @key("Ctrl+S")
//     void (Editor *e) save(i32 id) { ... }
//
// Like a Java @interface, each prototype fixes a name and the shape of its
// arguments; nothing ever calls it. The compiler checks every `@name(args)`
// against the prototype and records a row -- name, the annotated function,
// its receiver type's name and size, the arguments -- in the module's
// metadata table. app.mln reads those rows at boot (through meta.mln) and
// decides what they mean, when, and in what order.
//
// The first three parameters are always what the row carries about the
// annotated function; the rest are the annotation's own arguments, literal
// only, with defaults for the ones a use may leave out.
//
// A registered method is called with the instance pointer first --
// view(self), poll(self), save(self, id), open(self, path) -- and the DOM's
// uniform `handler(owner, id, arg)` reaches it the same way, since the
// calling convention ignores trailing arguments. Methods must therefore
// take a pointer receiver, which the compiler checks.

// On a type's view method: the type is an application. The framework
// allocates `size` bytes per instance (zeroed), calls view(self) to build
// the window and routes the window's events to the instance.
// `single`: launching it again focuses the running instance instead.
// `name`: the launcher label (default: the type's name).
export void app(i32 view, char *type, i32 size, bool single = false, char *name = "");

// fn(self) every `ms` milliseconds while an instance is mounted.
export void timer(i32 fn, char *type, i32 size, i32 ms);

// fn(self, id, code | mods << 16) when the key is pressed while the type's
// window is active. "Ctrl", "Shift", "Alt" and a key: a character, "Enter",
// "Esc", "Tab", "Space", "Left"..., "F1".."F12".
export void key(i32 fn, char *type, i32 size, char *combo);

// fn(self, path) when another app calls ui.open(path). A single-instance
// app's running instance receives it; otherwise a new one is started.
export void open(i32 fn, char *type, i32 size);

// fn(self) when the user closes the window, before the framework frees
// the instance and everything it created.
export void on_close(i32 fn, char *type, i32 size);
