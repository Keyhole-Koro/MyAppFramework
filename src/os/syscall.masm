; The SDK's binding to the kernel's syscall trap (MyKernel syscall.mln):
; the MyLang calling convention puts arguments in r5/r6/r7 and the result
; in r1; the trap takes the syscall number in r1 and leaves the result in
; r1. Numbers must match Syscall::* in syscall.mln.
export os_call
export sys_yield
export sys_exit
export sys_sbrk

; i32 os_call(i32 service, i32 args)  -- Syscall::OS_CALL
os_call:
  movi r1, 10
  syscall
  mov pc, lr

; void sys_yield()  -- Syscall::YIELD: let other tasks run until the next tick
sys_yield:
  movi r1, 8
  syscall
  mov pc, lr

; void sys_exit(i32 code)  -- Syscall::EXIT
sys_exit:
  movi r1, 1
  syscall
  mov pc, lr

; i32 sys_sbrk(i32 increment)  -- Syscall::SBRK: grow the heap; the old break
sys_sbrk:
  movi r1, 7
  syscall
  mov pc, lr
