package uiproto;

// The application's end of the UI protocol carriers declared in
// protocol.mln, for an app running as a process: each is an OS_CALL
// (os_services.mln). request() queues the message and yields until the
// reply is in; poll() takes one event; idle() yields a tick; exit() ends
// the process. Everything the message names by pointer is copied by the
// OS at the boundary.

import { os_call, sys_yield, sys_exit } from "syscall.masm";
import { OsService } from "../protocol/services.mln";
import { UiMsg, UiEvent } from "../protocol/ui.mln";

char g_event_text[64];   // an event's string payload, copied in by UI_POLL

export i32 request(UiMsg *m) {
    os_call(OsService::UI_REQUEST, (i32)m);
    i32 r[2];
    r[0] = 0;
    while (os_call(OsService::UI_REPLY, (i32)(&r[0])) == 0) {
        sys_yield();
    }
    return r[0];
}

export bool poll(UiEvent *out) {
    i32 args[2];
    args[0] = (i32)out;
    args[1] = (i32)(&g_event_text[0]);
    if (os_call(OsService::UI_POLL, (i32)(&args[0])) == 0) { return false; }
    out->text = &g_event_text[0];
    return true;
}

export void idle() {
    sys_yield();
}

export void exit() {
    sys_exit(0);
}
